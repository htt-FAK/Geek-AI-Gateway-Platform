DEEPSEEK_API_KEY=sk-your-deepseek-key
MIMO_API_KEY=sk-your-mimo-key
# 讯飞星辰 MaaS（https://maas-api.cn-huabei-1.xf-yun.com/v2）；每个服务/套餐独立 APIKey
XFYUN_MAAS_API_KEY=ak-your-xfyun-maas-key
# 硅基流动（https://api.siliconflow.cn/v1），OpenAI 兼容
SILICONFLOW_API_KEY=sk-your-siliconflow-key
LITELLM_MASTER_KEY=sk-your-gateway-master-key

# Compose overrides litellm DATABASE_URL to @postgres:5432; local tooling can use:
DATABASE_URL=postgresql://litellm:litellm@127.0.0.1:5432/litellm
POSTGRES_PASSWORD=litellm

# Web BFF reads GATEWAY_BASE_URL without trailing /v1
# GATEWAY_BASE_URL=http://127.0.0.1:4000
