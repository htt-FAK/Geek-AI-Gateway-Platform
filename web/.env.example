# App DB (sqlite local; use Postgres URL on server if preferred)
DATABASE_URL="file:./dev.db"

# Gateway
GATEWAY_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-change-me

# Auth
DEFAULT_USER_PASSWORD=ChangeMe123
AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
# 32-byte key as base64 for AES-256-GCM (generate: openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ADMIN_TOKEN=admin-change-me

DAILY_BUDGET_CNY=50
WEEKLY_BUDGET_CNY=200
MONTHLY_BUDGET_CNY=400

# Optional: only for running `node scripts/generate-brand-icons.mjs` (do not commit real key)
# AIGW_IMAGE_API_KEY=
# AIGW_IMAGE_BASE_URL=https://aigw.finloopai.ai/v1

# Optional public URLs for UI snippets / docs links
# PUBLIC_GATEWAY_BASE_URL=https://gateway.example.com
# DOCS_BASE_URL=https://docs.example.com

# 仅验收脚本用：允许 POST/DELETE /api/admin/test/spend 注入额度
# 生产可关；跑 server-e2e 前必须为 true
ALLOW_TEST_HOOKS=true
