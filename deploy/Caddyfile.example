# Caddy 反向代理示例（自动申请/续期 Let's Encrypt 证书，最省事的 HTTPS 方案）。
# 前提：域名已解析到服务器公网 IP，安全组放行 80/443；国内地域域名需完成 ICP 备案。
# 用法：复制到 /etc/caddy/Caddyfile（apt 安装 caddy 后），替换域名与邮箱，systemctl reload caddy。
#
# 为什么必须 HTTPS：Web 生产模式会话 Cookie 带 Secure，浏览器只在 HTTPS 或本机 localhost
# 发送；用 http://公网IP:3000 访问会登不进去（反复跳登录页）。

your-domain.example.com {
	# OpenAI 兼容 API：只暴露 /v1；/key /user /spend 等管理端点仍留在回环。
	handle /v1/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		encode gzip
		reverse_proxy 127.0.0.1:3000
	}
}

# 对外 API 地址：https://your-domain.example.com/v1
# 在 deploy/.env 设 PUBLIC_GATEWAY_BASE_URL=https://your-domain.example.com
# 网关 :4000 本身仍绑 127.0.0.1，只通过上面的 /v1 反代对外。