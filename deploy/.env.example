# Unified secrets for gateway + web (copy to deploy/.env)
# Upstream
DEEPSEEK_API_KEY=sk-your-deepseek-key
MIMO_API_KEY=sk-your-mimo-key
# 讯飞星辰 MaaS / 硅基流动（可选，不填则对应免费模型不可用）
XFYUN_MAAS_API_KEY=ak-your-xfyun-maas-key
SILICONFLOW_API_KEY=sk-your-siliconflow-key
# 阿里云百炼：公共 endpoint 如下；专属版账号换控制台示例里的 llm-xxx.maas.aliyuncs.com endpoint
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key

# LiteLLM / Postgres
LITELLM_MASTER_KEY=sk-change-me-master
POSTGRES_PASSWORD=litellm

# Web auth (generate with ./scripts/env-init.sh)
DEFAULT_USER_PASSWORD=ChangeMe123
AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
CREDENTIALS_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ADMIN_TOKEN=admin-change-me

# 余额制：新账号初始 ¥0，管理员在「用户管理」充值；测试账号默认不限额。

# Production default: false. ./scripts/test.sh toggles true during e2e.
ALLOW_TEST_HOOKS=false

# 对外 API 基地址（密钥页 / 调用示例里的 Base URL）。不填时，反代场景会用
# 请求的 Host 推导；生产建议显式写公网地址，例如 https://119.29.117.27
PUBLIC_GATEWAY_BASE_URL=

# 调试台图片目录。容器默认 /data/playground-uploads（web_data 卷）；
# 本机不填则用 <web>/data/playground-uploads。
# PLAYGROUND_UPLOAD_ROOT=/data/playground-uploads

# Host-side e2e / browser (compose overrides in-container GATEWAY_BASE_URL)
WEB_BASE_URL=http://127.0.0.1:3000
GATEWAY_BASE_URL=http://127.0.0.1:4000
