# Unified secrets for gateway + web (copy to deploy/.env)
# Upstream
DEEPSEEK_API_KEY=sk-your-deepseek-key
MIMO_API_KEY=sk-your-mimo-key

# LiteLLM / Postgres
LITELLM_MASTER_KEY=sk-change-me-master
POSTGRES_PASSWORD=litellm

# Web auth (generate with ./scripts/env-init.sh)
DEFAULT_USER_PASSWORD=ChangeMe123
AUTH_SECRET=replace-with-long-random-string-at-least-32-chars
CREDENTIALS_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ADMIN_TOKEN=admin-change-me

DAILY_BUDGET_CNY=50
WEEKLY_BUDGET_CNY=200

# Production default: false. ./scripts/test.sh toggles true during e2e.
ALLOW_TEST_HOOKS=false

# Host-side e2e / browser (compose overrides in-container GATEWAY_BASE_URL)
WEB_BASE_URL=http://127.0.0.1:3000
GATEWAY_BASE_URL=http://127.0.0.1:4000
